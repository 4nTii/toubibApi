FROM php:8.4-fpm

# Install system dependencies (Debian-based, no TLS issues with corporate proxy)
RUN apt-get update && apt-get install -y \
    bash \
    curl \
    git \
    unzip \
    openssl \
    libicu-dev \
    libonig-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo \
        pdo_mysql \
        intl \
        zip \
        mbstring \
        gd \
        opcache \
        sockets \
        ftp

# Install Xdebug and APCu
RUN pecl install xdebug apcu \
    && docker-php-ext-enable xdebug apcu

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Install Symfony CLI
RUN curl -sS --insecure https://get.symfony.com/cli/installer | bash \
    && mv /root/.symfony*/bin/symfony /usr/local/bin/symfony

WORKDIR /var/www/html

# Copy PHP config (dev)
COPY docker/php/php.dev.ini /usr/local/etc/php/conf.d/custom.ini
COPY docker/php/php-fpm.conf /usr/local/etc/php-fpm.d/zz-custom.conf

EXPOSE 9000 8000

CMD ["php-fpm"]