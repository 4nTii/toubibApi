# =============================================================================
#  Toubib API — committed defaults for APP_ENV=dev
# =============================================================================
#  Behavioural overrides for local development. Loaded automatically after
#  .env when APP_ENV=dev. NO secrets and NO infrastructure values here — put
#  those in .env (defaults) or .env.dev.local (uncommitted overrides).
# =============================================================================

###> symfony/framework-bundle ###
APP_DEBUG=1
###< symfony/framework-bundle ###

###> symfony/var-dumper ###
# Target for `bin/console server:dump` / the `dump()` helper.
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/var-dumper ###
