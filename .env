# -----------------------------------------
# Toubib -- Docker environment variables
# Copy this file to .env and fill in values
# -----------------------------------------

# Application
APP_ENV=dev
APP_SECRET=change_me_with_a_32_char_random_string

# MySQL
DB_ROOT_PASSWORD=rootpassword
DB_NAME=toubib
DB_USER=toubib_user
DB_PASSWORD=toubib_password

# JWT
JWT_PASSPHRASE=change_me_jwt_passphrase

# Redis
REDIS_PASSWORD=redis_password

# Mailer
# Dev  -> smtp://mailer:1025
# Prod -> smtp://user:pass@smtp.provider.com:587
MAILER_DSN=smtp://mailer:1025

# Symfony Messenger
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# CORS
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Nginx ports (production)
NGINX_PORT=80
NGINX_PORT_ALT=8080
NGINX_SSL_PORT=443
