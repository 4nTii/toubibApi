# =============================================================================
#  Toubib API — committed environment defaults
# =============================================================================
#  Loading order (Symfony Dotenv — later files win):
#    .env                  → this file: committed defaults, NO real secrets
#    .env.local            → uncommitted, machine/deploy-specific overrides + secrets
#    .env.<APP_ENV>        → committed env-specific defaults (.env.dev)
#    .env.<APP_ENV>.local  → uncommitted env-specific overrides
#  Real environment variables always win over any .env file.
#
#  Docker Compose also reads THIS file for ${...} interpolation. The values
#  below are functional for local Docker development as-is. For a real
#  deployment, override the secrets in .env.local (see .env.example).
#
#  DO NOT put production secrets in this file or any other committed file.
# =============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_32_char_hex_string
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://localhost:8000
###< symfony/routing ###

###> Database — consumed by docker-compose.yml (MySQL) and by DATABASE_URL ###
DB_HOST=db
DB_PORT=3306
DB_NAME=toubib
DB_USER=toubib_user
DB_PASSWORD=toubib_password
DB_ROOT_PASSWORD=root_password
DB_SERVER_VERSION=8.0
###< Database ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=${DB_SERVER_VERSION}&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> Redis ###
REDIS_PASSWORD=redis_password
###< Redis ###

###> symfony/messenger ###
# doctrine://default?auto_setup=0
# redis://:${REDIS_PASSWORD}@redis:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Dev  → Mailpit (docker-compose.override.yml): smtp://mailer:1025
# Prod → smtp://user:pass@smtp.provider.com:587?encryption=tls&auth_mode=login
MAILER_DSN=smtp://mailer:1025
MAILER_FROM_CONTACT=contact@toubib.com
MAILER_FROM_INFO=info@toubib.com
MAILER_FROM_NOREPLY=no-reply@toubib.com
MAILER_FROM_SUPPORT=support@toubib.com
MAILER_FROM_ADMIN=admin@toubib.com
MAILER_FROM_NEWS=news@toubib.com
###< symfony/mailer ###

###> Frontend URLs — links in transactional emails + %app_frontend_url% param ###
FRONT_CLIENT_URL=https://localhost:5173
BO_CLIENT_URL=https://localhost:5174
###< Frontend URLs ###

###> nelmio/cors-bundle — regex matched against the request Origin (origin_regex: true) ###
# Covers localhost, 127.0.0.1 and any 192.168.x.x LAN address, on any port.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_jwt_passphrase
###< lexik/jwt-authentication-bundle ###

###> Brute-force protection — App\Service\Auth\LoggingSecurityService ###
MAX_ATTEMPT_PER_USER=5
MAX_TIME_LIMIT_PER_USER=300
MAX_ATTEMPT_PER_IP=10
MAX_TIME_LIMIT_PER_IP=1800
###< Brute-force protection ###

###> FTP upload — App\Service\Helper\FileUploadHelper ###
# Not wired in local dev; uploads only work against a real FTP host (prod).
FTP_HOST=ftp.example.com
FTP_USER=change_me_ftp_user
FTP_PASS=change_me_ftp_password
FTP_BASE_DIR=/htdocs/files
VITE_FTP_TARGET=https://toubib.byethost24.com/files/
###< FTP upload ###

###> Nginx published HTTP port (docker-compose.yml) ###
NGINX_HTTP_PORT=8080
###< Nginx ###
