# =============================================================================
#  Toubib API — full .env template
# =============================================================================
#  Complete reference of every environment variable the app and the Docker
#  stack use. Copy it and adjust:
#
#      cp .env.example .env.local     # `make` also does this automatically
#
#  Loading order (Symfony Dotenv — the last one wins):
#      .env            committed defaults (enough to run the dev stack)
#      .env.local      THIS copy — uncommitted, your machine / your deployment
#      .env.dev        committed APP_ENV=dev tweaks
#      .env.dev.local  uncommitted
#  Real environment variables win over every file.
#
#  Note: `docker compose` only auto-reads `.env`. In the Docker DEV workflow the
#  key values are injected from `.env` via docker-compose.yml, so editing
#  `.env.local` mostly matters for `make prod-*` (loaded with --env-file) and
#  for running `bin/console` directly on the host.
#
#  DO NOT commit real secrets. Keep them in `.env.local` only.
# =============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
# 32-char hex — generate one: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=CHANGE_ME_32_char_hex_string
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Public base URL used to build absolute links (emails, CLI commands)
DEFAULT_URI=https://localhost:8000
###< symfony/routing ###

###> Database — consumed by docker-compose.yml (MySQL container) and DATABASE_URL ###
DB_HOST=db
DB_PORT=3306
DB_NAME=toubib
DB_USER=toubib_user
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password
DB_SERVER_VERSION=8.0
###< Database ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?serverVersion=${DB_SERVER_VERSION}&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> Redis — cache + Messenger transport ###
REDIS_PASSWORD=CHANGE_ME_redis_password
###< Redis ###

###> symfony/messenger ###
# doctrine://default?auto_setup=0                        (default, no extra service)
# redis://:${REDIS_PASSWORD}@redis:6379/messages         (use the Redis container)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Dev  → Mailpit (docker-compose.override.yml): smtp://mailer:1025
# Prod → smtp://user:pass@smtp.provider.com:587?encryption=tls&auth_mode=login
MAILER_DSN=smtp://mailer:1025
MAILER_FROM_CONTACT=contact@toubib.com
MAILER_FROM_INFO=info@toubib.com
MAILER_FROM_NOREPLY=no-reply@toubib.com
MAILER_FROM_SUPPORT=support@toubib.com
MAILER_FROM_ADMIN=admin@toubib.com
MAILER_FROM_NEWS=news@toubib.com
###< symfony/mailer ###

###> Frontend URLs — links in transactional emails + %app_frontend_url% param ###
FRONT_CLIENT_URL=https://localhost:5173
BO_CLIENT_URL=https://localhost:5174
###< Frontend URLs ###

###> nelmio/cors-bundle ###
# Regex (origin_regex: true) matched against the browser Origin header.
# Dev  → localhost / 127.0.0.1 / LAN 192.168.x.x on any port
# Prod → ^https://(app|bo)\.your-domain\.com$
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+)(:\d+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Must match the passphrase the config/jwt/*.pem keys were generated with
# (`make jwt-keys` uses this value). Regenerate keys with `make jwt-keys-force`.
JWT_PASSPHRASE=CHANGE_ME_jwt_passphrase
###< lexik/jwt-authentication-bundle ###

###> Brute-force protection — App\Service\Auth\LoggingSecurityService ###
MAX_ATTEMPT_PER_USER=5
MAX_TIME_LIMIT_PER_USER=300
MAX_ATTEMPT_PER_IP=10
MAX_TIME_LIMIT_PER_IP=1800
###< Brute-force protection ###

###> FTP upload — App\Service\Helper\FileUploadHelper ###
# Not wired in local dev; user-photo uploads only work against a real FTP host.
FTP_HOST=ftp.your-server.com
FTP_USER=CHANGE_ME_ftp_user
FTP_PASS=CHANGE_ME_ftp_password
FTP_BASE_DIR=/htdocs/files
VITE_FTP_TARGET=https://files.your-domain.com/files/
###< FTP upload ###

###> Nginx — published HTTP port of the nginx container (docker-compose.yml) ###
NGINX_HTTP_PORT=8080
###< Nginx ###

###> symfony/var-dumper — dev only, target of `bin/console server:dump` ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/var-dumper ###
